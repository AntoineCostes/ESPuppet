{
  "name":"Houdini",
  "type":"OSC",
  "path":"Les Incompressibles",

  "version":"1.2",
  "description":"Contrôle d'une machine à café par OSC",


  "hasInput":true,
  "hasOutput":true,

  "hideDefaultCommands":false,

  "defaults":
  {
    "autoAdd":true,
    "useHierarchy":true,
    "OSC Input":
    {
      "localPort":12345
    },

		"OSC Outputs":
		{
			"Alpha":
      {
        "local":false,
        "remoteHost":"houdini_alpha.local",
        "remotePort":12345
      },
			"Omega":
      {
        "local":false,
        "remoteHost":"houdini_omega.local",
        "remotePort":12345
      }
    }
  },

  "parameters":
  {
    "Yo":
    {
      "type":"Trigger"
    },
    "Set port":
    {
      "type":"Trigger"
    }
  },
  "hideDefaultParameters": ["useHierarchy",  "splitArguments", "autoFeedback", "autoAdd", "colorSendMode", "booleanSendMode", "clearValues", "pass_through", "oscInput/local", "oscOutputs/alpha/local", "oscOutputs/omega/local", "oscOutputs/alpha/listenToFeedback", "oscOutputs/omega/listenToFeedback"],

  "scripts":
  [
    "houdini.js"
  ],

  "values":
  {
  },

  "commands":
  {
    "Leds":
    {
      "callback":"setLeds",
      "menu":"Lumières",
      "parameters":
      {
        "Source":
        {
          "type":"Enum",
          "options":{"néons":0, "face":1, "baie":2, "all":3}
        },
        "Mode":
        {
          "type":"Enum",
          "options":{"solid":0, "blink":1, "glow":2, "chase":3, "rainbow":4, "random":5, "birandom":6, "gauge":7}
        },
        "Couleur":
        {
          "type":"Color",
          "default":[0.5, 0.5, 0.5, 1]
        },
        "Paramètre":
        {
          "type":"Float",
          "min":0,
          "max":1,
          "default":1
        },
        "Brightness":
        {
          "type":"Float",
          "min":0,
          "max":1,
          "default":1
        }
      }
    },
    "Voyant":
    {
      "callback":"setIndicator",
      "menu":"Lumières",
      "parameters":
      {
        "On/off":
        {
          "type":"Boolean",
          "default":1
        }
      }
    },
    "Feu Tricolore":
    {
      "callback":"setLight",
      "menu":"Lumières",
      "parameters":
      {
        "Rouge":
        {
          "type":"Boolean",
          "default":1
        },
        "Jaune":
        {
          "type":"Boolean",
          "default":1
        },
        "Vert":
        {
          "type":"Boolean",
          "default":1
        }
      }
    },
    "UV":
    {
      "callback":"setUV",
      "menu":"Lumières",
      "parameters":
      {
        "On/off":
        {
          "type":"Boolean",
          "default":1
        }
      }
    },
    "Plasma":
    {
      "callback":"setPlasma",
      "menu":"Lumières",
      "parameters":
      {
        "On/off":
        {
          "type":"Boolean",
          "default":1
        }
      }
    },
    "Electrovalve":
    {
      "callback":"setValve",
      "menu":"Electrovannes",
      "parameters":
      {
        "index":
        {
          "type":"Integer",
          "default":0,
          "min":1,
          "max":4
        },
        "value":
        {
          "type":"Boolean",
          "default":1
        }
      }
    },
    "Electrovalves":
    {
      "callback":"setValves",
      "menu":"Electrovannes",
      "parameters":
      {
        "1":
        {
          "type":"Boolean",
          "default":0
