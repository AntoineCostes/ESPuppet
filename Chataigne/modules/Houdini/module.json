        "3":
        {
          "type":"Boolean",
          "default":0
        },
        "4":
        {
          "type":"Boolean",
          "default":0
        }
      }
    },
    "Pompe 1":
    {
      "callback":"setPump1",
      "menu":"Pompes",
      "parameters":
      {
        "On/off":
        {
          "type":"Boolean",
          "default":1
        }
      }
    },
    "Pompe 2":
    {
      "callback":"setPump2",
      "menu":"Pompes",
      "parameters":
      {
        "On/off":
        {
          "type":"Boolean",
          "default":1
        }
      }
    },
    "Ventilateur 1":
    {
      "callback":"setFan1",
      "menu":"Ventilateurs",
      "parameters":
      {
        "Intensité":
        {
          "type":"Float",
          "min":0,
          "max":1,
          "default":1
        }
      }
    },
    "Extra 1":
    {
      "callback":"setExtra1",
      "menu":"Extras",
      "parameters":
      {
