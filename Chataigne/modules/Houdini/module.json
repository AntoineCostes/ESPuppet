    "Extra 2":
    {
      "callback":"setExtra2",
      "menu":"Extras",
      "parameters":
      {
        "On/off":
        {
          "type":"Boolean",
          "default":1
        }
      }
    },
    "Sourcils":
    {
      "callback":"setEyebrows",
      "menu":"Moteurs",
      "parameters":
      {
        "Moteur":
        {
          "type":"Enum",
          "options":{"gauche":0, "droit":1, "les deux":2}
        },
        "Position":
        {
          "type":"Float",
          "min":-1,
          "max":1,
          "default":0
        }
      }
    },
    "Sables":
    {
      "callback":"setServos",
      "menu":"Moteurs",
      "parameters":
      {
        "1":
        {
          "type":"Boolean",
          "default":1
        },
        "2":
        {
          "type":"Boolean",
          "default":1
        },
        "3":
        {
          "type":"Boolean",
          "default":1
        }
      }
    },
    "Arc":
    {
      "callback":"setArc",
      "menu":"Lance Flamme",
