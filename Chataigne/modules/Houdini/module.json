        {
          "type":"Boolean",
          "default":1
        }
      }
    },
    "Propane":
    {
      "callback":"setPropane",
      "menu":"Lance Flamme",
      "parameters":
      {
        "On/off":
        {
          "type":"Boolean",
          "default":1
        }
      }
    }
  }
}